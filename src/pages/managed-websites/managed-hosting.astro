---
import BaseLayout from '../../layouts/BaseLayout.astro';

const whatsIncluded = [
  'Hosting, SSL, and domain renewals — handled',
  'Security and monitoring — checked, not assumed',
  'Monthly update time for basic content and photo changes',
  'Custom contact forms, delivered straight to your inbox',
  'A real person who knows your site, not a support ticket queue',
  'Always current, always working',
];
---

<BaseLayout
  title="Managed Hosting — Managed Websites"
  description="Hosting, security, and updates for your website — handled by a real person, starting at $75/month."
>
  <!-- ======================== HEADER ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-charcoal)]" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-white/60 font-semibold text-sm uppercase tracking-widest mb-6">
        Managed Websites — Managed Hosting
      </p>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6"
        style="font-family: var(--font-heading);"
      >
        You're not paying for hosting. You're paying to never think about your website again.
      </h1>
      <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
        A real person makes sure your site is always current and working — so it's one less thing on your list.
      </p>
    </div>
  </section>

  <!-- ======================== WHAT'S INCLUDED ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12" data-animate>
        <h2
          class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
          style="font-family: var(--font-heading);"
        >
          What's included
        </h2>
        <p class="text-[var(--color-muted)] text-lg leading-relaxed">
          Everything it takes to keep your site current, secure, and working — without you having to think about it.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
        {whatsIncluded.map((item, i) => (
          <li
            class="flex items-start gap-3 p-5 rounded-xl bg-[var(--color-stone)] border border-[var(--color-border)]"
            data-animate
            data-animate-delay={String(i * 100)}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-navy)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-[var(--color-body)] text-base">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================== PRICING ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-8"
        style="font-family: var(--font-heading);"
      >
        Pricing
      </h2>
      <div class="bg-white rounded-2xl border border-[var(--color-border)] p-10 lg:p-12 inline-block">
        <p class="text-sm font-semibold uppercase tracking-widest text-[var(--color-muted)] mb-3">
          Starting at
        </p>
        <p class="text-5xl font-bold text-[var(--color-ink)] mb-2" style="font-family: var(--font-heading);">
          $75<span class="text-xl font-medium text-[var(--color-muted)]">/month</span>
        </p>
        <p class="text-[var(--color-muted)] text-base max-w-sm mb-4">
          Covers hosting, maintenance, and basic updates for your site — handled by a real person. No long-term contract.
        </p>
        <p class="text-[var(--color-muted)] text-sm max-w-sm border-t border-[var(--color-border)] pt-4">
          Sites that need database hosting, or more than basic monthly updates, are priced accordingly — we'll scope it together on your discovery call.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================== FAQ ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-10 text-center"
        style="font-family: var(--font-heading);"
      >
        Good to know
      </h2>
      <div class="space-y-6">
        <div>
          <h3 class="font-bold text-[var(--color-ink)] mb-1">Can I cancel anytime?</h3>
          <p class="text-[var(--color-body)] text-base leading-relaxed">
            Yes — no long-term contracts. We just ask for 30 days' notice.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-[var(--color-ink)] mb-1">Who owns the site?</h3>
          <p class="text-[var(--color-body)] text-base leading-relaxed">
            You do. Your domain, your design, your content — always.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-[var(--color-ink)] mb-1">What's included in monthly updates?</h3>
          <p class="text-[var(--color-body)] text-base leading-relaxed">
            Routine text and photo changes are included. Larger projects are scoped and quoted separately.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-[var(--color-ink)] mb-1">When does the price go up from $75/month?</h3>
          <p class="text-[var(--color-body)] text-base leading-relaxed">
            $75/month covers standard hosting and basic updates. If your site needs database hosting, or you want more update time each month than the basic tier covers, we'll quote the higher monthly rate before you commit to it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== CTA ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
        style="font-family: var(--font-heading);"
      >
        Ready for a website you don't have to think about?
      </h2>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-8 py-4 rounded-full text-lg font-semibold transition-colors"
      >
        Book a discovery call
      </a>
    </div>
  </section>
</BaseLayout>
