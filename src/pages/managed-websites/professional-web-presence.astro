---
import BaseLayout from '../../layouts/BaseLayout.astro';

const examples = [
  {
    label: 'A brochure site',
    description: 'A clean, credible home for your mission, programs, and story — the essential presence every nonprofit needs.',
  },
  {
    label: 'A multi-page site with interactive tools',
    description: 'Donation forms, event calendars, volunteer sign-ups, resource libraries — built to match how your team actually works.',
  },
  {
    label: 'A database-enabled application',
    description: 'Custom portals and tools that connect to real data behind the scenes — for organizations that need more than a website.',
  },
];
---

<BaseLayout
  title="Professional Web Presence — Managed Websites"
  description="From a simple brochure site to a multi-page site with interactive tools and database-enabled apps — a professional website built for how your organization actually works."
>
  <!-- ======================== HEADER ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-charcoal)]" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-white/60 font-semibold text-sm uppercase tracking-widest mb-6">
        Managed Websites — Professional Web Presence
      </p>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6"
        style="font-family: var(--font-heading);"
      >
        Websites built for how your organization actually works.
      </h1>
      <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
        We design and build every site from scratch for your organization — never a template. Whatever your organization needs, from a simple brochure site to a multi-page site with interactive tools and database-enabled apps, we build it.
      </p>
    </div>
  </section>

  <!-- ======================== WHAT THIS CAN LOOK LIKE ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12" data-animate>
        <h2
          class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
          style="font-family: var(--font-heading);"
        >
          What this can look like
        </h2>
        <p class="text-[var(--color-muted)] text-lg leading-relaxed">
          Every organization's needs are different — here's the range we build across.
        </p>
      </div>

      <ul class="grid grid-cols-1 gap-4" role="list">
        {examples.map((example, i) => (
          <li
            class="p-6 rounded-xl bg-[var(--color-stone)] border border-[var(--color-border)]"
            data-animate
            data-animate-delay={String(i * 100)}
          >
            <h3 class="text-lg font-bold text-[var(--color-ink)] mb-2" style="font-family: var(--font-heading);">
              {example.label}
            </h3>
            <p class="text-[var(--color-body)] text-base leading-relaxed">
              {example.description}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================== DONE-FOR-YOU ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-6"
        style="font-family: var(--font-heading);"
      >
        Built by a real person, not a template
      </h2>
      <p class="text-[var(--color-body)] text-lg leading-relaxed">
        No drag-and-drop builder, no generic theme. We work from your materials, your brand, and your programs to design a site that's actually yours — and every build starts with a discovery call to scope exactly what you need.
      </p>
    </div>
  </section>

  <!-- ======================== GROW-INTO LINE (to Managed Hosting) ======================== -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" data-animate>
      <div class="flex flex-col sm:flex-row sm:items-start gap-5 p-7 rounded-2xl bg-[var(--color-navy-tint)] border border-[var(--color-navy)]/15">
        <p class="text-[var(--color-body)] text-base leading-relaxed flex-1">
          Once your site is live, Managed Hosting is what keeps it running — a real person handling updates, security, and upkeep.
        </p>
        <a
          href="/managed-websites/managed-hosting"
          class="inline-flex items-center justify-center gap-2 text-[var(--color-navy)] font-semibold hover:gap-3 transition-all text-sm flex-shrink-0"
        >
          See Managed Hosting
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ======================== CTA ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
        style="font-family: var(--font-heading);"
      >
        Tell us what you need, and we'll scope it.
      </h2>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-8 py-4 rounded-full text-lg font-semibold transition-colors"
      >
        Book a discovery call
      </a>
    </div>
  </section>
</BaseLayout>
