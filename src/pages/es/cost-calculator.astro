---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CostCalculator from '../../components/CostCalculator.astro';
---

<BaseLayout
  title="Calculadora de Costos"
  description="¿Cuánto le están costando los datos dispersos a tu organización? Un estimado de 60 segundos, con solo unos toques, de las horas y el dinero que perdés cada año por datos fragmentados y reportes manuales."
>
  <section class="py-16 lg:py-20 bg-[var(--color-charcoal)]" data-animate>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-white/60 font-semibold text-sm uppercase tracking-widest mb-5">
        Calculadora de Costos
      </p>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-5"
        style="font-family: var(--font-heading);"
      >
        ¿Cuánto le están costando los datos dispersos a tu organización?
      </h1>
      <p class="text-white/70 text-lg leading-relaxed max-w-xl mx-auto">
        Unos toques, nada de escribir, nada de tarea. Obtené un estimado aproximado de las horas y el dinero que perdés cada año por datos fragmentados y reportes manuales.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <CostCalculator />
    </div>
  </section>
</BaseLayout>
