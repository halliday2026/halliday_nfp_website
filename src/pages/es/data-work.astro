---
// Productized offer name ("El Análisis de Insights de Donantes") is a
// translation of the provisional English name — lock the final Spanish name
// alongside the English one before final copy ships.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pillars } from '../../data/pillars';
import { beforeAfter } from '../../data/before-after';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
const before = beforeAfter[lang].before;
const after = beforeAfter[lang].after;
const dataPillars = pillars[lang].filter((p) => p.key !== 'web-presence');

const included = [
  'Análisis de retención de donantes',
  'Identificación de donantes en riesgo o inactivos',
  'Segmentación por ciclo de vida',
  'Tendencias de los donantes principales',
];

const pillarIcons: Record<string, string> = {
  'raise-more': `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>`,
  'report-faster': `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
  'prove-impact': `<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
};
---

<BaseLayout
  title="Trabajo de Datos"
  description="Herramientas de datos a la medida que ayudan a las organizaciones sin fines de lucro a recaudar más, reportar más rápido y demostrar su impacto. Los proyectos comienzan en $7,500."
>
  <!-- ======================== HEADER ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-charcoal)]" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-white/60 font-semibold text-sm uppercase tracking-widest mb-6">
        Trabajo de Datos
      </p>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6"
        style="font-family: var(--font-heading);"
      >
        Las herramientas de datos a la medida que te ayudan a recaudar más, reportar más rápido y demostrar tu impacto.
      </h1>
      <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
        Más allá del sitio web, acá es donde Halliday hace su trabajo más profundo — convirtiendo los datos que ya tenés en decisiones sobre las que podés actuar.
      </p>
    </div>
  </section>

  <!-- ======================== FULL BEFORE / AFTER ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14" data-animate>
        <h2
          class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
          style="font-family: var(--font-heading);"
        >
          De disperso a claro
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[var(--color-stone)] rounded-2xl p-8 border border-[var(--color-border)]" data-animate>
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)] mb-5">Antes</p>
          <ul class="space-y-3">
            {before.map((line) => (
              <li class="flex items-start gap-3 text-[var(--color-body)] text-base leading-relaxed">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-muted)] flex-shrink-0 mt-2.5" />
                {line}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-[var(--color-navy-tint)] rounded-2xl p-8 border border-[var(--color-navy)]/20" data-animate data-animate-delay="100">
          <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-navy)] mb-5">Después</p>
          <ul class="space-y-3">
            {after.map((line) => (
              <li class="flex items-start gap-3 text-[var(--color-body)] text-base leading-relaxed">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-navy)] flex-shrink-0 mt-2.5" />
                {line}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== THREE DATA PILLARS, EXPANDED ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-6">
        {dataPillars.map((pillar, i) => (
          <div
            class="bg-white rounded-2xl p-8 lg:p-10 border border-[var(--color-border)] grid grid-cols-1 md:grid-cols-[auto_1fr] gap-6 md:gap-10 items-start"
            data-animate
            data-animate-delay={String(i * 100)}
          >
            <div class="w-14 h-14 rounded-xl bg-[var(--color-navy)]/10 flex items-center justify-center text-[var(--color-navy)]" set:html={pillarIcons[pillar.key]} />
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest text-[var(--color-navy)] mb-2">{pillar.eyebrow}</p>
              <h3
                class="text-xl sm:text-2xl font-bold text-[var(--color-ink)] mb-4"
                style="font-family: var(--font-heading);"
              >
                {pillar.title}
              </h3>
              <p class="text-[var(--color-body)] text-base leading-relaxed mb-5">{pillar.body}</p>
              <div class="flex flex-col sm:flex-row gap-4 text-sm">
                <p class="flex-1 text-[var(--color-muted)]"><span class="font-semibold text-[var(--color-ink)]">Hoy: </span>{pillar.pain}</p>
                <p class="flex-1 text-[var(--color-navy)]"><span class="font-semibold">Con Halliday: </span>{pillar.payoff}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================== THE PRODUCTIZED OFFER ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[var(--color-charcoal)] rounded-3xl p-8 lg:p-12" data-animate>
        <p class="text-white/50 font-semibold text-sm uppercase tracking-widest mb-4">El Proyecto</p>
        <h2
          class="text-2xl sm:text-3xl font-bold text-white mb-5"
          style="font-family: var(--font-heading);"
        >
          El Análisis de Insights de Donantes
        </h2>
        <p class="text-white/70 text-base leading-relaxed mb-8 max-w-2xl">
          Un análisis de donantes de alcance fijo, entregado completamente hecho por nosotros. No te entregamos un montón de datos sin procesar — obtenés los hallazgos y las acciones recomendadas que los acompañan.
        </p>

        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-10">
          {included.map((item) => (
            <li class="flex items-start gap-3 text-white/85 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white/50 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4 pt-6 border-t border-white/10">
          <p class="text-white font-semibold">Los proyectos comienzan en $7,500.</p>
          <a
            href="/es/contact"
            class="inline-flex items-center justify-center gap-2 bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-6 py-3 rounded-full text-sm font-semibold transition-colors sm:ml-auto"
          >
            {t('cta.bookCall')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== WHAT WORKING TOGETHER LOOKS LIKE ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-14" data-animate>
        <h2
          class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
          style="font-family: var(--font-heading);"
        >
          Cómo es trabajar juntos
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div data-animate>
          <div class="text-[var(--color-navy)] text-4xl font-bold mb-4 opacity-60" style="font-family: var(--font-heading);">01</div>
          <h3 class="text-lg font-bold text-[var(--color-ink)] mb-3" style="font-family: var(--font-heading);">Una llamada de descubrimiento gratuita</h3>
          <p class="text-[var(--color-muted)] text-sm leading-relaxed">Conversamos sobre tu organización, tus datos y lo que realmente es posible. Sin ofertas de venta, sin compromiso.</p>
        </div>
        <div data-animate data-animate-delay="100">
          <div class="text-[var(--color-navy)] text-4xl font-bold mb-4 opacity-60" style="font-family: var(--font-heading);">02</div>
          <h3 class="text-lg font-bold text-[var(--color-ink)] mb-3" style="font-family: var(--font-heading);">El proyecto</h3>
          <p class="text-[var(--color-muted)] text-sm leading-relaxed">Alcance fijo, precio fijo, entregado con los hallazgos y las acciones recomendadas que necesitás para actuar de inmediato.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== CUSTOM-BUILD DIFFERENTIATOR ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" data-animate>
      <h2
        class="text-2xl sm:text-3xl font-bold text-[var(--color-ink)] mb-6"
        style="font-family: var(--font-heading);"
      >
        Por qué esto no es una solución genérica
      </h2>
      <div class="space-y-4 text-[var(--color-body)] text-base leading-relaxed">
        <p>
          No empezamos con una plantilla de panel de control. Empezamos con tus programas — qué medís en realidad, por qué, y qué historia necesitan contar los números. Lo que realmente marca la diferencia no es el gráfico que ves; es la lógica de transformación y el pensamiento de "¿qué deberíamos medir?" que lo construyó.
        </p>
        <p>
          Cuando la respuesta correcta es una herramienta construida a la medida, eso es lo que construimos — ajustada a cómo funciona realmente tu organización, no forzada dentro del software de alguien más.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================== FINAL CTA ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
        style="font-family: var(--font-heading);"
      >
        ¿Querés ver qué te están diciendo tus datos?
      </h2>
      <p class="text-[var(--color-muted)] text-lg mb-4">
        Empezá con una llamada de descubrimiento gratuita.
      </p>
      <a
        href="/es/contact"
        class="inline-flex items-center gap-2 bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-8 py-4 rounded-full text-lg font-semibold transition-colors"
      >
        {t('cta.bookCall')}
      </a>
      <p class="text-[var(--color-muted)] text-sm mt-6">
        ¿Todavía no sabés? <a href="/es/cost-calculator" class="text-[var(--color-navy)] font-medium hover:underline">Mirá cuánto te podrían estar costando ya los datos dispersos</a>.
      </p>
    </div>
  </section>
</BaseLayout>
