---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const summaryCards = [
  {
    label: 'Presencia Web Profesional',
    description: 'Lo que construimos — desde un sitio sencillo tipo folleto hasta un sitio de varias páginas con herramientas interactivas y aplicaciones con base de datos.',
    href: '/es/managed-websites/professional-web-presence',
  },
  {
    label: 'Hosting Administrado',
    description: 'Lo que lo mantiene funcionando — hosting, seguridad y actualizaciones, a cargo de una persona real. Los precios son transparentes, ahí mismo en la página.',
    href: '/es/managed-websites/managed-hosting',
  },
  {
    label: 'Paquete Inicial',
    description: 'Cómo es empezar — desde tu primera llamada hasta el día del lanzamiento.',
    href: '/es/managed-websites/starter-package',
  },
];
---

<BaseLayout
  title="Sitios Web Administrados"
  description="Un sitio web profesional que armamos y mantenemos funcionando por vos. Una persona real se asegura de que esté siempre actualizado y funcionando, para que no tengas que volver a pensarlo."
>
  <!-- ======================== HEADER ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-charcoal)]" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-white/60 font-semibold text-sm uppercase tracking-widest mb-6">
        Sitios Web Administrados
      </p>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6"
        style="font-family: var(--font-heading);"
      >
        Una presencia web profesional — resuelta por nosotros.
      </h1>
      <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
        Lo construimos, lo mantenemos funcionando, y nos aseguramos de que nunca falle — para que vos te enfoqués en tu misión. Acá hay dos cosas ciertas: lo que construimos y lo que cobramos por mantenerlo funcionando son conversaciones distintas. Así es como se dividen.
      </p>
    </div>
  </section>

  <!-- ======================== SUMMARY CARDS ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-6" role="list">
        {summaryCards.map((card, i) => (
          <li
            class="flex flex-col p-7 rounded-2xl bg-[var(--color-stone)] border border-[var(--color-border)]"
            data-animate
            data-animate-delay={String(i * 100)}
          >
            <h2
              class="text-xl font-bold text-[var(--color-ink)] mb-3"
              style="font-family: var(--font-heading);"
            >
              {card.label}
            </h2>
            <p class="text-[var(--color-body)] text-base leading-relaxed mb-6 flex-1">
              {card.description}
            </p>
            <a
              href={card.href}
              class="inline-flex items-center gap-2 text-[var(--color-navy)] font-semibold hover:gap-3 transition-all text-sm"
            >
              {t('cta.learnMore')}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================== WHO IT'S FOR ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-6"
        style="font-family: var(--font-heading);"
      >
        Para quién es
      </h2>
      <p class="text-[var(--color-body)] text-lg leading-relaxed mb-6">
        Cualquier organización sin fines de lucro que necesite una presencia web creíble — sin importar su tamaño o presupuesto.
      </p>
      <p class="text-[var(--color-muted)] text-base leading-relaxed">
        Y para los consultores, coaches y redactores de propuestas en su órbita, esa misma presencia web hecha por nosotros mantiene su presencia profesional funcionando — para que puedan enfocarse en sus clientes.
      </p>
    </div>
  </section>

  <!-- ======================== GROW-INTO LINE ======================== -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" data-animate>
      <div class="flex flex-col sm:flex-row sm:items-start gap-5 p-7 rounded-2xl bg-[var(--color-navy-tint)] border border-[var(--color-navy)]/15">
        <p class="text-[var(--color-body)] text-base leading-relaxed flex-1">
          Y cuando estés listo, esta es la puerta hacia las herramientas de datos — convirtiendo lo que ya tenés en decisiones sobre las que podés actuar.
        </p>
        <a
          href="/es/data-work"
          class="inline-flex items-center justify-center gap-2 text-[var(--color-navy)] font-semibold hover:gap-3 transition-all text-sm flex-shrink-0"
        >
          {t('cta.seeDataWork')}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ======================== CTA ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
        style="font-family: var(--font-heading);"
      >
        ¿Querés un sitio web del que no tengas que preocuparte?
      </h2>
      <a
        href="/es/contact"
        class="inline-flex items-center gap-2 bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-8 py-4 rounded-full text-lg font-semibold transition-colors"
      >
        Empezá ahora
      </a>
    </div>
  </section>
</BaseLayout>
