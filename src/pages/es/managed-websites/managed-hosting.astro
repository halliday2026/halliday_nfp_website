---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const whatsIncluded = [
  'Hosting, SSL y renovaciones de dominio — resueltos',
  'Seguridad y monitoreo — verificado, no asumido',
  'Tiempo de actualización mensual para cambios básicos de contenido y fotos',
  'Formularios de contacto personalizados, enviados directo a tu correo',
  'Una persona real que conoce tu sitio, no una fila de tickets de soporte',
  'Siempre actualizado, siempre funcionando',
];
---

<BaseLayout
  title="Hosting Administrado — Sitios Web Administrados"
  description="Hosting, seguridad y actualizaciones para tu sitio web — a cargo de una persona real, desde $75/mes."
>
  <!-- ======================== HEADER ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-charcoal)]" data-animate>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-white/60 font-semibold text-sm uppercase tracking-widest mb-6">
        Sitios Web Administrados — Hosting Administrado
      </p>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-6"
        style="font-family: var(--font-heading);"
      >
        No estás pagando por hosting. Estás pagando para nunca más tener que pensar en tu sitio web.
      </h1>
      <p class="text-white/70 text-lg leading-relaxed max-w-2xl">
        Una persona real se asegura de que tu sitio esté siempre actualizado y funcionando — para que sea una preocupación menos en tu lista.
      </p>
    </div>
  </section>

  <!-- ======================== WHAT'S INCLUDED ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12" data-animate>
        <h2
          class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
          style="font-family: var(--font-heading);"
        >
          Qué incluye
        </h2>
        <p class="text-[var(--color-muted)] text-lg leading-relaxed">
          Todo lo necesario para mantener tu sitio actualizado, seguro y funcionando — sin que tengas que pensarlo.
        </p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
        {whatsIncluded.map((item, i) => (
          <li
            class="flex items-start gap-3 p-5 rounded-xl bg-[var(--color-stone)] border border-[var(--color-border)]"
            data-animate
            data-animate-delay={String(i * 100)}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[var(--color-navy)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-[var(--color-body)] text-base">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================== PRICING ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-8"
        style="font-family: var(--font-heading);"
      >
        Precios
      </h2>
      <div class="bg-white rounded-2xl border border-[var(--color-border)] p-10 lg:p-12 inline-block">
        <p class="text-sm font-semibold uppercase tracking-widest text-[var(--color-muted)] mb-3">
          Desde
        </p>
        <p class="text-5xl font-bold text-[var(--color-ink)] mb-2" style="font-family: var(--font-heading);">
          $75<span class="text-xl font-medium text-[var(--color-muted)]">/mes</span>
        </p>
        <p class="text-[var(--color-muted)] text-base max-w-sm mb-4">
          Incluye hosting, mantenimiento y actualizaciones básicas para tu sitio — a cargo de una persona real. Sin contrato a largo plazo.
        </p>
        <p class="text-[var(--color-muted)] text-sm max-w-sm border-t border-[var(--color-border)] pt-4">
          Los sitios que necesitan hosting con base de datos, o más actualizaciones mensuales de las básicas, tienen un precio acorde — lo definimos juntos en tu llamada de descubrimiento.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================== FAQ ======================== -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-10 text-center"
        style="font-family: var(--font-heading);"
      >
        Bueno saberlo
      </h2>
      <div class="space-y-6">
        <div>
          <h3 class="font-bold text-[var(--color-ink)] mb-1">¿Puedo cancelar en cualquier momento?</h3>
          <p class="text-[var(--color-body)] text-base leading-relaxed">
            Sí — sin contratos a largo plazo. Solo pedimos 30 días de aviso.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-[var(--color-ink)] mb-1">¿Quién es dueño del sitio?</h3>
          <p class="text-[var(--color-body)] text-base leading-relaxed">
            Vos. Tu dominio, tu diseño, tu contenido — siempre.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-[var(--color-ink)] mb-1">¿Qué incluyen las actualizaciones mensuales?</h3>
          <p class="text-[var(--color-body)] text-base leading-relaxed">
            Los cambios de texto y fotos de rutina están incluidos. Los proyectos más grandes se definen y cotizan por separado.
          </p>
        </div>
        <div>
          <h3 class="font-bold text-[var(--color-ink)] mb-1">¿Cuándo sube el precio de $75/mes?</h3>
          <p class="text-[var(--color-body)] text-base leading-relaxed">
            $75/mes cubre hosting estándar y actualizaciones básicas. Si tu sitio necesita hosting con base de datos, o querés más tiempo de actualización del que cubre el plan básico, te cotizamos la tarifa mensual más alta antes de que te comprometás.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== CTA ======================== -->
  <section class="py-20 lg:py-28 bg-[var(--color-stone)]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-animate>
      <h2
        class="text-3xl sm:text-4xl font-bold text-[var(--color-ink)] mb-5"
        style="font-family: var(--font-heading);"
      >
        ¿Querés un sitio web del que no tengas que preocuparte?
      </h2>
      <a
        href="/es/contact"
        class="inline-flex items-center gap-2 bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-8 py-4 rounded-full text-lg font-semibold transition-colors"
      >
        {t('cta.bookCall')}
      </a>
    </div>
  </section>
</BaseLayout>
