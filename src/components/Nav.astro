---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import hLogoIcon from '../assets/H_Logo.svg';
import { navItems } from '../data/nav-links';
import { getLangFromUrl, useTranslations, stripLocalePrefix } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = navItems.map((item) => ({
  href: getRelativeLocaleUrl(lang, item.path),
  label: t(item.key),
  children: item.children?.map((child) => ({
    href: getRelativeLocaleUrl(lang, child.path),
    label: t(child.key),
  })),
}));
const overviewLabel = t('nav.managedWebsitesOverview');
const homeHref = getRelativeLocaleUrl(lang, '/');
const bookCallHref = getRelativeLocaleUrl(lang, '/contact');
const currentPathStripped = stripLocalePrefix(Astro.url.pathname);
const enHref = getRelativeLocaleUrl('en', currentPathStripped);
const esHref = getRelativeLocaleUrl('es', currentPathStripped);

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-[var(--color-border)] shadow-sm">
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a href={homeHref} class="flex items-center gap-2.5 flex-shrink-0" aria-label="Halliday home">
      <Image src={hLogoIcon} alt="" width={28} height={32} class="h-8 w-auto" />
      <span class="font-heading font-bold text-lg tracking-wide text-[var(--color-charcoal)]">HALLIDAY</span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden lg:flex items-center gap-1" role="list">
      {
        navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== homeHref && currentPath.startsWith(link.href));
          if (!link.children) {
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'px-3 py-2 rounded-md text-sm font-medium transition-colors',
                    isActive
                      ? 'text-[var(--color-navy)] font-semibold'
                      : 'text-[var(--color-muted)] hover:text-[var(--color-navy)]',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          }
          return (
            <li class="relative nav-dropdown">
              <button
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                class:list={[
                  'nav-dropdown-toggle flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium transition-colors',
                  isActive
                    ? 'text-[var(--color-navy)] font-semibold'
                    : 'text-[var(--color-muted)] hover:text-[var(--color-navy)]',
                ]}
              >
                {link.label}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform nav-dropdown-caret" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <ul
                class="nav-dropdown-panel hidden absolute left-0 top-full mt-1 min-w-[240px] py-2 rounded-xl bg-white border border-[var(--color-border)] shadow-lg"
                role="list"
              >
                <li>
                  <a
                    href={link.href}
                    class="block px-4 py-2 text-sm font-semibold text-[var(--color-ink)] hover:bg-[var(--color-stone)]"
                  >
                    {overviewLabel}
                  </a>
                </li>
                <li class="my-1 border-t border-[var(--color-border)]" role="presentation" />
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={currentPath === child.href ? 'page' : undefined}
                      class:list={[
                        'block px-4 py-2 text-sm transition-colors',
                        currentPath === child.href
                          ? 'text-[var(--color-navy)] font-semibold bg-[var(--color-navy-tint)]'
                          : 'text-[var(--color-muted)] hover:text-[var(--color-navy)] hover:bg-[var(--color-stone)]',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>

    <!-- Language switcher (desktop) -->
    <div class="hidden lg:flex items-center gap-1 text-sm font-medium mr-2" aria-label="Language">
      <a
        href={enHref}
        aria-current={lang === 'en' ? 'page' : undefined}
        class:list={[
          'px-2 py-1 rounded transition-colors',
          lang === 'en' ? 'text-[var(--color-navy)] font-semibold' : 'text-[var(--color-muted)] hover:text-[var(--color-navy)]',
        ]}
      >
        EN
      </a>
      <span class="text-[var(--color-border)]" aria-hidden="true">/</span>
      <a
        href={esHref}
        aria-current={lang === 'es' ? 'page' : undefined}
        class:list={[
          'px-2 py-1 rounded transition-colors',
          lang === 'es' ? 'text-[var(--color-navy)] font-semibold' : 'text-[var(--color-muted)] hover:text-[var(--color-navy)]',
        ]}
      >
        ES
      </a>
    </div>

    <!-- Desktop CTA -->
    <div class="hidden lg:block">
      <a
        href={bookCallHref}
        class="inline-flex items-center gap-2 bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-5 py-2.5 rounded-full text-sm font-semibold transition-colors"
      >
        {t('cta.bookCall')}
      </a>
    </div>

    <!-- Hamburger button -->
    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="lg:hidden p-2 rounded-md text-[var(--color-muted)] hover:text-[var(--color-navy)] hover:bg-gray-100 transition-colors"
    >
      <span class="sr-only">Toggle navigation menu</span>
      <svg
        id="hamburger-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-[var(--color-border)] bg-white"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <ul class="px-4 py-3 space-y-1" role="list">
      {
        navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== homeHref && currentPath.startsWith(link.href));
          if (!link.children) {
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'block px-3 py-2.5 rounded-md text-base font-medium transition-colors',
                    isActive
                      ? 'bg-[var(--color-navy)]/10 text-[var(--color-navy)] font-semibold'
                      : 'text-[var(--color-muted)] hover:text-[var(--color-navy)] hover:bg-gray-50',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          }
          return (
            <li>
              <button
                type="button"
                aria-expanded="false"
                class:list={[
                  'mobile-dropdown-toggle w-full flex items-center justify-between px-3 py-2.5 rounded-md text-base font-medium transition-colors',
                  isActive
                    ? 'bg-[var(--color-navy)]/10 text-[var(--color-navy)] font-semibold'
                    : 'text-[var(--color-muted)] hover:text-[var(--color-navy)] hover:bg-gray-50',
                ]}
              >
                {link.label}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform mobile-dropdown-caret" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <ul class="mobile-dropdown-panel hidden pl-4 mt-1 space-y-1 border-l border-[var(--color-border)] ml-3" role="list">
                <li>
                  <a
                    href={link.href}
                    class="block px-3 py-2 rounded-md text-sm font-semibold text-[var(--color-ink)] hover:bg-gray-50"
                  >
                    {overviewLabel}
                  </a>
                </li>
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={currentPath === child.href ? 'page' : undefined}
                      class:list={[
                        'block px-3 py-2 rounded-md text-sm transition-colors',
                        currentPath === child.href
                          ? 'text-[var(--color-navy)] font-semibold bg-[var(--color-navy)]/10'
                          : 'text-[var(--color-muted)] hover:text-[var(--color-navy)] hover:bg-gray-50',
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
      <li class="px-3 pt-3 pb-1 flex items-center gap-4 text-base font-medium" aria-label="Language">
        <a
          href={enHref}
          aria-current={lang === 'en' ? 'page' : undefined}
          class:list={lang === 'en' ? 'text-[var(--color-navy)] font-semibold' : 'text-[var(--color-muted)]'}
        >
          English
        </a>
        <a
          href={esHref}
          aria-current={lang === 'es' ? 'page' : undefined}
          class:list={lang === 'es' ? 'text-[var(--color-navy)] font-semibold' : 'text-[var(--color-muted)]'}
        >
          Español
        </a>
      </li>
      <li class="pt-2">
        <a
          href={bookCallHref}
          class="block text-center bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-5 py-3 rounded-full text-base font-semibold transition-colors"
        >
          {t('cta.bookCall')}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close mobile menu when a link is clicked
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  // Desktop dropdown: click to toggle, hover to open, outside click / Escape to close
  document.querySelectorAll<HTMLLIElement>('.nav-dropdown').forEach((dropdown) => {
    const dropdownToggle = dropdown.querySelector<HTMLButtonElement>('.nav-dropdown-toggle');
    const panel = dropdown.querySelector<HTMLUListElement>('.nav-dropdown-panel');
    const caret = dropdown.querySelector<SVGElement>('.nav-dropdown-caret');
    if (!dropdownToggle || !panel) return;

    const openDropdown = () => {
      panel.classList.remove('hidden');
      dropdownToggle.setAttribute('aria-expanded', 'true');
      caret?.classList.add('rotate-180');
    };
    const closeDropdown = () => {
      panel.classList.add('hidden');
      dropdownToggle.setAttribute('aria-expanded', 'false');
      caret?.classList.remove('rotate-180');
    };

    dropdownToggle.addEventListener('click', () => {
      const expanded = dropdownToggle.getAttribute('aria-expanded') === 'true';
      expanded ? closeDropdown() : openDropdown();
    });
    dropdown.addEventListener('mouseenter', openDropdown);
    dropdown.addEventListener('mouseleave', closeDropdown);
    dropdown.addEventListener('focusout', (event) => {
      if (!dropdown.contains(event.relatedTarget as Node | null)) closeDropdown();
    });
    document.addEventListener('click', (event) => {
      if (!dropdown.contains(event.target as Node)) closeDropdown();
    });
    dropdown.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeDropdown();
        dropdownToggle.focus();
      }
    });
  });

  // Mobile accordion: tapping the parent expands/collapses its submenu
  document.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-toggle').forEach((accordionToggle) => {
    const panel = accordionToggle.nextElementSibling as HTMLUListElement | null;
    const caret = accordionToggle.querySelector<SVGElement>('.mobile-dropdown-caret');
    if (!panel) return;

    accordionToggle.addEventListener('click', () => {
      const expanded = accordionToggle.getAttribute('aria-expanded') === 'true';
      accordionToggle.setAttribute('aria-expanded', String(!expanded));
      panel.classList.toggle('hidden');
      caret?.classList.toggle('rotate-180');
    });
  });
</script>
