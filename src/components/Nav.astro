---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import hLogoIcon from '../assets/H_Logo.svg';
import { navItems } from '../data/nav-links';
import { getLangFromUrl, useTranslations, stripLocalePrefix } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = navItems.map((item) => ({
  href: getRelativeLocaleUrl(lang, item.path),
  label: t(item.key),
}));
const homeHref = getRelativeLocaleUrl(lang, '/');
const bookCallHref = getRelativeLocaleUrl(lang, '/contact');
const currentPathStripped = stripLocalePrefix(Astro.url.pathname);
const enHref = getRelativeLocaleUrl('en', currentPathStripped);
const esHref = getRelativeLocaleUrl('es', currentPathStripped);

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-[var(--color-border)] shadow-sm">
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a href={homeHref} class="flex items-center gap-2.5 flex-shrink-0" aria-label="Halliday home">
      <Image src={hLogoIcon} alt="" width={28} height={32} class="h-8 w-auto" />
      <span class="font-heading font-bold text-lg tracking-wide text-[var(--color-charcoal)]">HALLIDAY</span>
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden lg:flex items-center gap-1" role="list">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href || (link.href !== homeHref && currentPath.startsWith(link.href)) ? 'page' : undefined}
              class:list={[
                'px-3 py-2 rounded-md text-sm font-medium transition-colors',
                currentPath === link.href || (link.href !== homeHref && currentPath.startsWith(link.href))
                  ? 'text-[var(--color-navy)] font-semibold'
                  : 'text-[var(--color-muted)] hover:text-[var(--color-navy)]',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Language switcher (desktop) -->
    <div class="hidden lg:flex items-center gap-1 text-sm font-medium mr-2" aria-label="Language">
      <a
        href={enHref}
        aria-current={lang === 'en' ? 'page' : undefined}
        class:list={[
          'px-2 py-1 rounded transition-colors',
          lang === 'en' ? 'text-[var(--color-navy)] font-semibold' : 'text-[var(--color-muted)] hover:text-[var(--color-navy)]',
        ]}
      >
        EN
      </a>
      <span class="text-[var(--color-border)]" aria-hidden="true">/</span>
      <a
        href={esHref}
        aria-current={lang === 'es' ? 'page' : undefined}
        class:list={[
          'px-2 py-1 rounded transition-colors',
          lang === 'es' ? 'text-[var(--color-navy)] font-semibold' : 'text-[var(--color-muted)] hover:text-[var(--color-navy)]',
        ]}
      >
        ES
      </a>
    </div>

    <!-- Desktop CTA -->
    <div class="hidden lg:block">
      <a
        href={bookCallHref}
        class="inline-flex items-center gap-2 bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-5 py-2.5 rounded-full text-sm font-semibold transition-colors"
      >
        {t('cta.bookCall')}
      </a>
    </div>

    <!-- Hamburger button -->
    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="lg:hidden p-2 rounded-md text-[var(--color-muted)] hover:text-[var(--color-navy)] hover:bg-gray-100 transition-colors"
    >
      <span class="sr-only">Toggle navigation menu</span>
      <svg
        id="hamburger-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-[var(--color-border)] bg-white"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <ul class="px-4 py-3 space-y-1" role="list">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href || (link.href !== homeHref && currentPath.startsWith(link.href)) ? 'page' : undefined}
              class:list={[
                'block px-3 py-2.5 rounded-md text-base font-medium transition-colors',
                currentPath === link.href || (link.href !== homeHref && currentPath.startsWith(link.href))
                  ? 'bg-[var(--color-navy)]/10 text-[var(--color-navy)] font-semibold'
                  : 'text-[var(--color-muted)] hover:text-[var(--color-navy)] hover:bg-gray-50',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="px-3 pt-3 pb-1 flex items-center gap-4 text-base font-medium" aria-label="Language">
        <a
          href={enHref}
          aria-current={lang === 'en' ? 'page' : undefined}
          class:list={lang === 'en' ? 'text-[var(--color-navy)] font-semibold' : 'text-[var(--color-muted)]'}
        >
          English
        </a>
        <a
          href={esHref}
          aria-current={lang === 'es' ? 'page' : undefined}
          class:list={lang === 'es' ? 'text-[var(--color-navy)] font-semibold' : 'text-[var(--color-muted)]'}
        >
          Español
        </a>
      </li>
      <li class="pt-2">
        <a
          href={bookCallHref}
          class="block text-center bg-[var(--color-navy)] hover:bg-[var(--color-navy-dark)] text-white px-5 py-3 rounded-full text-base font-semibold transition-colors"
        >
          {t('cta.bookCall')}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close mobile menu when a link is clicked
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
